def parse_fault_query(value: str) -> tuple[int, int] | None:
    """Accept forms such as '100/1', 'SPN 100 FMI 1', or '100 FMI 1'."""
    if not value.strip():
        return None

    match = re.search(
        r"(?:SPN\s*)?(\d{1,6})\s*(?:[,/: -]\s*|FMI\s*)(?:FMI\s*)?(\d{1,2})",
        value,
        flags=re.IGNORECASE,
    )
    if not match:
        return None

    try:
        spn, fmi = int(match.group(1)), int(match.group(2))
    except ValueError:
        return None

    if spn < 0 or fmi < 0 or fmi > 31:
        return None
    return spn, fmi


